@page "/login"
@using System.Net.Http.Json
@using BBooking.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject BBooking.Blazor.Services.CustomAuthStateProvider AuthStateProvider

<style>
    /* ... (stili invariati) ... */
</style>

<div class="login-container">
    <h2 class="login-title">Accedi a BBooking</h2>

    <EditForm Model="loginModel" OnValidSubmit="GestisciLogin">
        <div class="form-group">
            <label for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="loginModel.Email" placeholder="guest@bbooking.com" />
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" placeholder="Inserisci password" />
        </div>

        <button type="submit" class="btn-submit">Accedi</button>
    </EditForm>

    @if (!string.IsNullOrEmpty(messaggio))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
            @messaggio
        </div>
    }
</div>

@code {
    private LoginDto loginModel = new();
    private string? messaggio;
    private bool isSuccess;

    private async Task GestisciLogin()
    {
        try
        {
            messaggio = "Autenticazione in corso..."; 
            
            var response = await Http.PostAsJsonAsync("api/v1/auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResult>();
                
                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    isSuccess = true;
                    messaggio = "Login effettuato! Reindirizzamento...";
                    
                    // 1. Salva il token e notifica lo stato di autenticazione
                    await AuthStateProvider.NotificaSitoLogin(result.Token);
                    
                    // 2. Reindirizza l'utente dopo un breve delay
                    await Task.Delay(1500);
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                isSuccess = false;
                // Tentiamo di leggere il messaggio di errore dal backend (se presente come JSON)
                try {
                    var errorObj = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                    messaggio = errorObj != null && errorObj.ContainsKey("messaggio") ? errorObj["messaggio"] : "Credenziali non valide.";
                } catch {
                    messaggio = "Errore di autenticazione. Riprova.";
                }
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            messaggio = $"Errore di connessione: {ex.Message}. Assicurati che il backend sia attivo.";
        }
    }

    public class LoginDto
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class LoginResult
    {
        public string Token { get; set; } = string.Empty;
        public string Ruolo { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
    }
}